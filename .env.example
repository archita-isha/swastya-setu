# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored — never commit real credentials.

# Generate a fresh Gmail App Password at:
# https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the account)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional overrides
HOSPITAL_NAME=City Blood Bank, Mysore
CONTACT_NUMBER=+91XXXXXXXXXX

# Server Configuration
# PORT=5000

# Mail Server Configuration (defaults to Google SMTP/IMAP)
# IMAP_SERVER=imap.gmail.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=465

# Data & Agent Settings
# EXCEL_FILE=blood_donors_50.xlsx
# REQUIRED_DONORS=2
# BATCH_SIZE=20
# SEND_DELAY=5
# CHECK_INTERVAL=30

# Textbee Free SMS Gateway API Setup (https://textbee.dev)
# Leave blank to fall back to simulated console logs
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# WhatsApp Gateway Options (Leave blank to fall back to simulated console logs)
# Option A: Twilio WhatsApp Sandbox / API (https://www.twilio.com)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option B: Meta WhatsApp Cloud API (https://developers.facebook.com)
# WHATSAPP_CLOUD_TOKEN=EAAxxxxxx...
# WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
# WHATSAPP_VERIFY_TOKEN=swastya_setu_verify

# Option C: Generic WhatsApp API (UltraMsg / Green-API / CallMeBot / Custom)
# WHATSAPP_API_URL=https://api.ultramsg.com/instanceXXXXX/messages/chat
# WHATSAPP_API_KEY=xxxxxxxxxxxx


