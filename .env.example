# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored — never commit real credentials.

# Generate a fresh Gmail App Password at:
# https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the account)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional overrides
HOSPITAL_NAME=City Blood Bank, Mysore
CONTACT_NUMBER=+91XXXXXXXXXX

# Server Configuration
# PORT=5000

# Mail Server Configuration (defaults to Google SMTP/IMAP)
# IMAP_SERVER=imap.gmail.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=465

# Data & Agent Settings
# EXCEL_FILE=blood_donors_50.xlsx
# REQUIRED_DONORS=2
# BATCH_SIZE=20
# SEND_DELAY=5
# CHECK_INTERVAL=30

